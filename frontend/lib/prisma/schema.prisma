generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  uploading
  transcribing
  detecting
  extracting
  rendering
  storing
  complete
  failed
}

enum StageStatus {
  pending
  running
  complete
  failed
}

enum SegmentStatus {
  pending
  approved
  rejected
}

model Job {
  id                  String        @id @default(cuid())
  status              JobStatus     @default(uploading)
  sourceFilename      String
  sourceSiaObjectId   String?
  durationSeconds     Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  transcript          Transcript?
  segments            Segment[]
  pipelineSteps       PipelineStep[]

  @@map("jobs")
}

model Transcript {
  id            String   @id @default(cuid())
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vttContent    String
  jsonContent   Json
  siaObjectId   String?
  createdAt     DateTime @default(now())

  @@map("transcripts")
}

model Segment {
  id                String        @id @default(cuid())
  jobId             String
  job               Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startSeconds      Float
  endSeconds        Float
  hookStrength      String
  viralityScore     Int
  emotionalSignal   String
  transcriptExcerpt String
  status            SegmentStatus @default(pending)
  clipPath          String?
  siaObjectId       String?
  createdAt         DateTime      @default(now())

  @@map("segments")
}

model PipelineStep {
  id           String      @id @default(cuid())
  jobId        String
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage        String
  status       StageStatus @default(pending)
  progressPct  Int         @default(0)
  message      String      @default("")
  startedAt    DateTime?
  completedAt  DateTime?

  @@map("pipeline_steps")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}
