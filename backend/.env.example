# ReBit Backend — Environment Variables

# Database
DATABASE_URL="postgresql+asyncpg://rebit:rebit@localhost:5432/rebit"

# FastAPI
DEBUG=false
CORS_ORIGINS="http://localhost:3000"

# Sia Storage
# SIA_MODE: "auto" (default) or "demo" — demo skips all Sia operations
SIA_MODE="auto"
SIA_KEY_PATH="/tmp/sia/appkey.hex"

# OpenRouter (for LLM-based analysis)
OPENROUTER_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Whisper
WHISPER_MODEL="base"
WHISPER_DEVICE="cpu"

# File storage
UPLOAD_DIR="/tmp/rebit/uploads"
OUTPUT_DIR="/tmp/rebit/output"

# yt-dlp (YouTube cookies file path)
# Export cookies from your browser to bypass YouTube bot detection:
#   1. Install the "Get cookies.txt LOCALLY" browser extension
#   2. Visit youtube.com while logged in
#   3. Export cookies to /tmp/rebit/youtube_cookies.txt
# YT_DLP_COOKIES="/tmp/rebit/youtube_cookies.txt"

# Pipeline
MAX_UPLOAD_SIZE_MB=500
