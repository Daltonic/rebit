# ReBit Backend — Environment Variables

# Database
DATABASE_URL="postgresql+asyncpg://rebit:rebit@localhost:5432/rebit"

# FastAPI
DEBUG=false
CORS_ORIGINS="http://localhost:3000"

# Sia Storage
# SIA_MODE: "auto" (default) or "demo" — demo skips all Sia operations
SIA_MODE="auto"
SIA_KEY_PATH="data/sia/appkey.hex"

# Whisper
WHISPER_MODEL="base"
WHISPER_DEVICE="cpu"

# File storage
UPLOAD_DIR="data/uploads"
OUTPUT_DIR="data/output"

# Pipeline
MAX_UPLOAD_SIZE_MB=500